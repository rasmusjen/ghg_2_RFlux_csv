# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Type checking / test / tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.whl

# Logs and local runtime files
*.log
*.pid

# Jupyter
.ipynb_checkpoints/

# IDE / editor local settings
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Secrets / local overrides
.env
.env.*
*.local
config.local.ini

# Golden-baseline and scratch working dirs (real instrument data; never committed)
golden/
scratch/
scratch_*/

# Run artifacts that must never enter the repo (QA manifest + sidecar are written
# into the OUTPUT DATA dir; if one of these appears here, a run was misconfigured)
*.ghg
*_ghg2rluxcsv_report_*.html
*_ghg2rluxcsv_report_*.csv

# Generated dependency pins are tracked; local resolver output is not
pip-wheel-metadata/
